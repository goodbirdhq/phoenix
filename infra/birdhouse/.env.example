# Copy to .env.local for local development.

# Postgres connection string for the ops hub's own database. Create it once:
#   createdb phoenix_ops
OPS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phoenix_ops"

# HTTP surface (built in a later wave — the callback endpoint, mostly).
OPS_HTTP_PORT=3878
OPS_PUBLIC_URL="http://127.0.0.1:3878"

# Phoenix's own HTTP API, for launching agent sessions.
PHOENIX_BASE_URL="http://127.0.0.1:3873"
# Unset until Phoenix issues tokens; every call site must treat "unset" as
# unauthenticated rather than assume this is present.
PHOENIX_OPS_TOKEN=

# How often the scheduler checks for due workflow schedules.
OPS_SCHEDULER_TICK_MS=15000

OPS_TIMEZONE="Europe/London"
