# Copy to .env.local for local development.

# Postgres connection string for birdhouse's own database. Create it once:
#   createdb phoenix_birdhouse
BIRDHOUSE_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phoenix_birdhouse"

# HTTP surface: the run-result callback, health, and the manual trigger.
# Bound to 127.0.0.1 — see README before exposing it.
BIRDHOUSE_HTTP_PORT=3878
# The base URL agents are told to POST their result to. Must match the port
# above; it is embedded in every run's prompt.
BIRDHOUSE_PUBLIC_URL="http://127.0.0.1:3878"

# Phoenix's own HTTP API, for launching agent sessions.
PHOENIX_BASE_URL="http://127.0.0.1:3873"
# Unset until Phoenix issues tokens; every call site must treat "unset" as
# unauthenticated rather than assume this is present.
PHOENIX_BIRDHOUSE_TOKEN=

# The Phoenix project runs launch into. Required for any non-fake run.
PHOENIX_PROJECT_ID=

# How often the scheduler checks for due workflow schedules, syncs workflow
# definitions from disk, and retires runs past their deadline.
BIRDHOUSE_SCHEDULER_TICK_MS=15000

BIRDHOUSE_TIMEZONE="Europe/London"
